PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-a-new-random-secret>
JWT_EXPIRES_IN=2h

# Optional integrations
OPENAI_API_KEY=
RAG_API_URL=

# Optional password-reset email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
MAIL_FROM=
FRONTEND_URL=http://localhost:5173
